# Copy to .env and set private, unique local values before starting Docker Compose.
MYSQL_ROOT_PASSWORD=replace-with-a-private-local-root-password
DATABASE_PASSWORD=replace-with-a-private-local-app-password
GYM_ADMIN_PASSWORD=replace-with-a-private-local-admin-password
GYM_STAFF_PASSWORD=replace-with-a-private-local-staff-password

